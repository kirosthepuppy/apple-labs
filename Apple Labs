#!/bin/bash
#
# roblox-bootstrapper — install, update, configure and launch Roblox on macOS.
#
# A small Bloxstrap-style bootstrapper: it keeps Roblox.app on the latest
# version straight from Roblox's CDN, re-applies your FastFlags after every
# update, and can take over roblox:// / roblox-player:// links so every
# launch from the website goes through it.
#
# Written for the bash 3.2 that ships with macOS (no associative arrays,
# no ${var,,}, no mapfile).

set -euo pipefail

VERSION="1.5.0"

# ---------------------------------------------------------------------------
# Configuration (all overridable through the environment)
# ---------------------------------------------------------------------------

SUPPORT_DIR="${ROBLOX_BOOTSTRAPPER_HOME:-$HOME/Library/Application Support/RobloxBootstrapper}"
CONFIG_FILE="$SUPPORT_DIR/config"
FFLAGS_FILE="$SUPPORT_DIR/fflags.json"
STATE_FILE="$SUPPORT_DIR/installed-version"
LOG_FILE="$SUPPORT_DIR/bootstrapper.log"
MODS_DIR="$SUPPORT_DIR/Modifications"
MODS_BACKUP_DIR="$SUPPORT_DIR/ModBackups"
MODS_MANIFEST="$SUPPORT_DIR/mods-applied"
HANDLER_APP="$HOME/Applications/Apple Labs.app"
# What the launcher app was called before 1.5; moved to the new name on register.
LEGACY_HANDLER_APP="$HOME/Applications/Roblox Bootstrapper.app"
HANDLER_BUNDLE_ID="com.robloxbootstrapper.handler"
LAUNCHER_ZIP_URL="https://github.com/kirosthepuppy/apple-labs/releases/latest/download/Apple-Labs.zip"

# Set by the launcher app: it shows its own progress and notifications.
GUI_MODE="${ROBLOX_BOOTSTRAPPER_GUI:-}"

# Persisted settings (see `config` command). Environment wins over the file.
_env_channel="${ROBLOX_CHANNEL:-}"
_env_dir="${ROBLOX_INSTALL_DIR:-}"
_env_arch="${ROBLOX_ARCH:-}"
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
CHANNEL="${_env_channel:-${CHANNEL:-LIVE}}"
INSTALL_DIR="${_env_dir:-${INSTALL_DIR:-/Applications}}"
ARCH="${_env_arch:-${ARCH:-auto}}"

APP_NAME="Roblox.app"
VERSION_API="https://clientsettingscdn.roblox.com/v2/client-version/MacPlayer"
CDN_BASE="https://setup.rbxcdn.com"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

if [ -t 1 ]; then
  C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_OFF=$'\033[0m'
else
  C_BOLD=""; C_DIM=""; C_RED=""; C_GRN=""; C_YEL=""; C_OFF=""
fi

log()  { mkdir -p "$SUPPORT_DIR"; printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null || true; }
info() { printf '%s==>%s %s\n' "$C_BOLD" "$C_OFF" "$*"; log "INFO $*"; }
ok()   { printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*"; log "OK   $*"; }
warn() { printf '%swarning:%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; log "WARN $*"; }
die()  { printf '%serror:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; log "ERR  $*"; notify "Roblox Bootstrapper" "$*"; exit 1; }

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

# Show a notification when running headless (e.g. launched from a browser link).
notify() {
  [ -t 1 ] && return 0
  [ -n "$GUI_MODE" ] && return 0
  is_macos || return 0
  osascript - "$1" "$2" >/dev/null 2>&1 <<'EOF' || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
EOF
}

# ---------------------------------------------------------------------------
# JSON helper
#
# macOS has no jq by default, but it always has JavaScript for Automation.
# The script body only uses plain JS so it also runs under node (used when
# testing off-mac). Usage: json_js '<js body using `args` and returning a
# string>' arg...
# ---------------------------------------------------------------------------

json_js() {
  local body="$1"; shift
  local prog="function run(args) { $body }"
  if is_macos && command -v osascript >/dev/null 2>&1; then
    osascript -l JavaScript -e "$prog" "$@"
  elif command -v node >/dev/null 2>&1; then
    node -e "$prog; process.stdout.write(String(run(process.argv.slice(1))) + '\n')" -- "$@"
  else
    die "need osascript (macOS) or node to edit JSON"
  fi
}

# ---------------------------------------------------------------------------
# Paths / platform
# ---------------------------------------------------------------------------

app_path() { printf '%s/%s' "$INSTALL_DIR" "$APP_NAME"; }

resolve_arch() {
  case "$ARCH" in
    arm64|x86_64) printf '%s' "$ARCH"; return ;;
    auto) ;;
    *) die "unknown ARCH '$ARCH' (use auto, arm64 or x86_64)" ;;
  esac
  # hw.optional.arm64 is 1 on Apple Silicon even when we run under Rosetta.
  if [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ] || [ "$(uname -m)" = "arm64" ]; then
    printf 'arm64'
  else
    printf 'x86_64'
  fi
}

channel_is_live() {
  case "$CHANNEL" in LIVE|live|Live|"") return 0 ;; *) return 1 ;; esac
}

version_url() {
  if channel_is_live; then printf '%s' "$VERSION_API"
  else printf '%s/channel/%s' "$VERSION_API" "$CHANNEL"; fi
}

download_url() {
  local version="$1" arch prefix
  arch="$(resolve_arch)"
  if channel_is_live; then prefix="$CDN_BASE/mac"
  else prefix="$CDN_BASE/channel/$CHANNEL/mac"; fi
  [ "$arch" = "arm64" ] && prefix="$prefix/arm64"
  printf '%s/%s-RobloxPlayer.zip' "$prefix" "$version"
}

installed_version() {
  [ -d "$(app_path)" ] || return 0
  [ -f "$STATE_FILE" ] && cat "$STATE_FILE"
  return 0
}

installed_display_version() {
  local plist
  plist="$(app_path)/Contents/Info.plist"
  [ -f "$plist" ] || return 0
  if command -v defaults >/dev/null 2>&1; then
    defaults read "$plist" CFBundleShortVersionString 2>/dev/null || true
  else
    grep -A1 CFBundleShortVersionString "$plist" | sed -n 's:.*<string>\(.*\)</string>.*:\1:p'
  fi
}

# Prints "<clientVersionUpload> <version>" for the configured channel.
fetch_latest() {
  local json
  json="$(curl -fsSL --retry 3 --connect-timeout 10 "$(version_url)")" \
    || die "could not reach Roblox's version service ($(version_url))"
  json_js '
    var d = JSON.parse(args[0]);
    if (!d.clientVersionUpload) throw new Error(JSON.stringify(d));
    return d.clientVersionUpload + " " + d.version;
  ' "$json" || die "unexpected response from version service: $json"
}

# ROBLOX_PROCESS_NAME lets tests run while a real Roblox is open.
roblox_running() { pgrep -x "${ROBLOX_PROCESS_NAME:-RobloxPlayer}" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# FastFlags
# ---------------------------------------------------------------------------

ensure_fflags_file() {
  mkdir -p "$SUPPORT_DIR"
  [ -s "$FFLAGS_FILE" ] || printf '{}\n' > "$FFLAGS_FILE"
}

# Write the user's flags into the installed client.
apply_fflags() {
  local app dir
  app="$(app_path)"
  [ -d "$app" ] || return 0
  ensure_fflags_file
  dir="$app/Contents/MacOS/ClientSettings"
  mkdir -p "$dir"
  # Round-trip through the JSON parser so a hand-edited file with a typo is
  # caught here rather than silently ignored by Roblox.
  json_js 'return JSON.stringify(JSON.parse(args[0]), null, 2);' "$(cat "$FFLAGS_FILE")" \
    > "$dir/ClientAppSettings.json.tmp" || { rm -f "$dir/ClientAppSettings.json.tmp"; die "$FFLAGS_FILE is not valid JSON"; }
  mv "$dir/ClientAppSettings.json.tmp" "$dir/ClientAppSettings.json"
}

# ---------------------------------------------------------------------------
# Mods
#
# Files in $MODS_DIR mirror Roblox.app/Contents/Resources (so a mod at
# Modifications/content/sounds/ouch.ogg replaces the death sound). They are
# copied in after every update. Originals are backed up so removing a mod
# restores Roblox's file. A font at content/fonts/CustomFont.ttf (or .otf)
# is additionally wired into every font family, like Bloxstrap does.
# ---------------------------------------------------------------------------

# Only one mods apply at a time. The launcher app can start several at once
# (a mod change and a launch), and two interleaved runs used to restore the
# same original twice and then delete it. shlock clears a lock whose owner
# has died.
mods_lock() {
  local lock="$SUPPORT_DIR/.mods.lock" tries=0
  mkdir -p "$SUPPORT_DIR"
  until shlock -f "$lock" -p $$; do
    tries=$((tries + 1))
    [ "$tries" -gt 600 ] && die "another mods update is still running; try again"
    sleep 0.1
  done
}

mods_unlock() { rm -f "$SUPPORT_DIR/.mods.lock"; }

apply_mods() {
  local app res stage font ext rel fam added
  app="$(app_path)"
  [ -d "$app" ] || return 0
  res="$app/Contents/Resources"
  mods_lock
  mkdir -p "$MODS_DIR" "$MODS_BACKUP_DIR"
  touch "$MODS_MANIFEST"
  # Files a mod added that Roblox doesn't have; removing the mod deletes them.
  added="$MODS_BACKUP_DIR/.added"
  touch "$added"

  stage="$(mktemp -d "${TMPDIR:-/tmp}/roblox-mods.XXXXXX")"
  ditto "$MODS_DIR" "$stage"
  find "$stage" -name .DS_Store -delete

  font=""
  for ext in ttf otf; do
    [ -f "$stage/content/fonts/CustomFont.$ext" ] && font="CustomFont.$ext"
  done
  if [ -n "$font" ]; then
    mkdir -p "$stage/content/fonts/families"
    for fam in "$res/content/fonts/families/"*.json; do
      [ -f "$fam" ] || continue
      rel="content/fonts/families/$(basename "$fam")"
      # Build from the original file when we have already replaced it.
      [ -f "$MODS_BACKUP_DIR/$rel" ] && fam="$MODS_BACKUP_DIR/$rel"
      sed -E "s#(\"assetId\" *: *)\"[^\"]*\"#\1\"rbxasset://fonts/$font\"#g" "$fam" > "$stage/$rel"
    done
  fi

  (cd "$stage" && find . -type f | sed 's#^\./##' | LC_ALL=C sort) > "$MODS_MANIFEST.new"

  # Put back files whose mod was removed. A file with no backup is deleted
  # only if a mod added it; anything else is Roblox's own and stays.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    grep -qxF "$rel" "$MODS_MANIFEST.new" && continue
    if [ -f "$MODS_BACKUP_DIR/$rel" ]; then
      mv "$MODS_BACKUP_DIR/$rel" "$res/$rel"
    elif grep -qxF "$rel" "$added"; then
      rm -f "$res/$rel"
      { grep -vxF "$rel" "$added" || true; } > "$added.tmp"; mv "$added.tmp" "$added"
    else
      warn "no backup of Roblox's $rel; left it as is (reinstall Roblox to restore it)"
    fi
  done < "$MODS_MANIFEST"

  # Copy mods in, backing up each original the first time we replace it.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if ! grep -qxF "$rel" "$MODS_MANIFEST"; then
      if [ -f "$res/$rel" ]; then
        mkdir -p "$(dirname "$MODS_BACKUP_DIR/$rel")"
        cp -p "$res/$rel" "$MODS_BACKUP_DIR/$rel"
      elif ! grep -qxF "$rel" "$added"; then
        printf '%s\n' "$rel" >> "$added"
      fi
    fi
    mkdir -p "$(dirname "$res/$rel")"
    # Copy beside it and rename over it: a Roblox left running (it stays in the
    # menu bar) may have the old file mapped, and overwriting that in place
    # crashes it.
    cp "$stage/$rel" "$res/$rel.applelabs-new" && mv -f "$res/$rel.applelabs-new" "$res/$rel"
  done < "$MODS_MANIFEST.new"

  mv "$MODS_MANIFEST.new" "$MODS_MANIFEST"
  rm -rf "$stage"
  mods_unlock
}

apply_customizations() {
  apply_fflags
  apply_mods
}

cmd_mods() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  mkdir -p "$MODS_DIR"
  case "$sub" in
    list|ls)
      (cd "$MODS_DIR" && find . -type f ! -name .DS_Store | sed 's#^\./##' | LC_ALL=C sort) | grep . || echo "(no mods)"
      return ;;
    path) printf '%s\n' "$MODS_DIR"; return ;;
    apply) ;;
    clear)
      rm -rf "$MODS_DIR"; mkdir -p "$MODS_DIR"
      ok "removed all mods" ;;
    *) die "unknown mods command '$sub' (list, apply, clear, path)" ;;
  esac
  if [ -d "$(app_path)" ]; then
    apply_mods
    ok "mods applied to Roblox"
    roblox_running && warn "Roblox is running; restart it for mod changes to take effect"
  fi
  return 0
}

# Turn a CLI value into a JSON value: true/false/numbers stay typed,
# everything else becomes a string. Roblox accepts both for most flags.
cmd_fflags() {
  ensure_fflags_file
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  local current; current="$(cat "$FFLAGS_FILE")"
  case "$sub" in
    list|ls)
      json_js '
        var d = JSON.parse(args[0]), k = Object.keys(d).sort();
        if (!k.length) return "(no FastFlags set)";
        return k.map(function (n) { return n + " = " + JSON.stringify(d[n]); }).join("\n");
      ' "$current"
      return ;;
    set)
      [ $# -eq 2 ] || die "usage: fflags set <FlagName> <value>"
      json_js '
        var d = JSON.parse(args[0]), v = args[2];
        if (v === "true") v = true;
        else if (v === "false") v = false;
        else if (/^-?\d+$/.test(v)) v = parseInt(v, 10);
        d[args[1]] = v;
        return JSON.stringify(d, null, 2);
      ' "$current" "$1" "$2" > "$FFLAGS_FILE.tmp"
      ok "set $1" ;;
    unset|rm|remove)
      [ $# -ge 1 ] || die "usage: fflags unset <FlagName>..."
      json_js '
        var d = JSON.parse(args[0]);
        for (var i = 1; i < args.length; i++) delete d[args[i]];
        return JSON.stringify(d, null, 2);
      ' "$current" "$@" > "$FFLAGS_FILE.tmp"
      ok "removed $*" ;;
    import)
      [ $# -eq 1 ] || die "usage: fflags import <file.json>"
      [ -f "$1" ] || die "no such file: $1"
      json_js '
        var d = JSON.parse(args[0]), n = JSON.parse(args[1]);
        if (typeof n !== "object" || n === null || Array.isArray(n)) throw new Error("expected a JSON object");
        for (var k in n) d[k] = n[k];
        return JSON.stringify(d, null, 2);
      ' "$current" "$(cat "$1")" > "$FFLAGS_FILE.tmp" 2>/dev/null || { rm -f "$FFLAGS_FILE.tmp"; die "$1 is not a JSON object of flags"; }
      ok "imported flags from $1" ;;
    clear)
      printf '{}\n' > "$FFLAGS_FILE.tmp"
      ok "cleared all FastFlags" ;;
    edit)
      "${EDITOR:-nano}" "$FFLAGS_FILE"
      json_js 'JSON.parse(args[0]); return "ok";' "$(cat "$FFLAGS_FILE")" >/dev/null \
        || die "$FFLAGS_FILE is no longer valid JSON; fix it and run \`$0 fflags apply\`"
      ;;
    apply) ;;
    path) printf '%s\n' "$FFLAGS_FILE"; return ;;
    *) die "unknown fflags command '$sub' (list, set, unset, import, clear, edit, apply, path)" ;;
  esac
  [ -f "$FFLAGS_FILE.tmp" ] && mv "$FFLAGS_FILE.tmp" "$FFLAGS_FILE"
  if [ -d "$(app_path)" ]; then
    apply_fflags
    ok "FastFlags written to Roblox"
    roblox_running && warn "Roblox is running; restart it for flag changes to take effect"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Install / update
# ---------------------------------------------------------------------------

# Download while printing "@progress <percent>" lines for the launcher app.
download_with_progress() {
  local url="$1" out="$2" total size pid
  total="$(curl -fsSIL --connect-timeout 15 "$url" | tr -d '\r' \
    | awk 'tolower($1) == "content-length:" { n = $2 } END { print n + 0 }')"
  curl -fsSL --retry 3 --connect-timeout 15 -o "$out" "$url" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$total" -gt 0 ]; then
      size="$(stat -f %z "$out" 2>/dev/null || echo 0)"
      printf '@progress %d\n' $((size * 100 / total))
    fi
    sleep 0.3
  done
  wait "$pid"
}

install_version() {
  local hash="$1" display="$2" url tmp app dest_parent
  url="$(download_url "$hash")"
  app="$(app_path)"
  dest_parent="$INSTALL_DIR"

  if [ ! -d "$dest_parent" ]; then
    mkdir -p "$dest_parent" 2>/dev/null || die "cannot create $dest_parent"
  fi
  if [ ! -w "$dest_parent" ]; then
    die "$dest_parent is not writable; run \`$0 config set INSTALL_DIR ~/Applications\` or re-run with sudo"
  fi
  if roblox_running; then
    die "Roblox is running; quit it before updating"
  fi

  tmp="$(mktemp -d "${TMPDIR:-/tmp}/roblox-bootstrapper.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  info "Downloading Roblox $display ($(resolve_arch), channel $CHANNEL)"
  if [ -n "$GUI_MODE" ]; then
    download_with_progress "$url" "$tmp/RobloxPlayer.zip" || die "download failed: $url"
  else
    local progress="-#"; [ -t 2 ] || progress="-sS"
    curl -fL $progress --retry 3 --connect-timeout 15 -o "$tmp/RobloxPlayer.zip" "$url" \
      || die "download failed: $url"
  fi

  info "Extracting"
  mkdir -p "$tmp/x"
  if command -v ditto >/dev/null 2>&1; then
    ditto -x -k "$tmp/RobloxPlayer.zip" "$tmp/x" || die "archive is corrupt"
  else
    unzip -q "$tmp/RobloxPlayer.zip" -d "$tmp/x" || die "archive is corrupt"
  fi
  [ -d "$tmp/x/RobloxPlayer.app" ] || die "archive did not contain RobloxPlayer.app"

  # Swap the new app in; keep the old one until the move succeeds.
  if [ -d "$app" ]; then
    mv "$app" "$tmp/old.app" || die "could not move old $app out of the way"
  fi
  if ! mv "$tmp/x/RobloxPlayer.app" "$app"; then
    [ -d "$tmp/old.app" ] && mv "$tmp/old.app" "$app"
    die "could not install to $app"
  fi

  is_macos && xattr -dr com.apple.quarantine "$app" 2>/dev/null || true
  mkdir -p "$SUPPORT_DIR"
  printf '%s\n' "$hash" > "$STATE_FILE"
  # A fresh app has Roblox's original files, so old mod backups are stale.
  rm -rf "$MODS_BACKUP_DIR" "$MODS_MANIFEST"
  apply_customizations

  rm -rf "$tmp"; trap - EXIT
  ok "Roblox $display installed at $app"
}

# Returns 0 after installing/updating, 1 if already current.
update_if_needed() {
  local force="${1:-}" latest hash display current
  latest="$(fetch_latest)"
  hash="${latest%% *}"; display="${latest#* }"
  current="$(installed_version)"
  if [ -z "$current" ] && [ -d "$(app_path)" ] && [ "$(installed_display_version)" = "$display" ]; then
    # Adopt an install we didn't make when it is already the latest version.
    mkdir -p "$SUPPORT_DIR"; printf '%s\n' "$hash" > "$STATE_FILE"; current="$hash"
  fi
  if [ -z "$force" ] && [ "$current" = "$hash" ]; then
    return 1
  fi
  if [ -n "$current" ]; then info "Updating Roblox $(installed_display_version) → $display"
  else info "Installing Roblox $display"; fi
  notify "Roblox Bootstrapper" "Installing Roblox ${display}…"
  install_version "$hash" "$display"
  return 0
}

cmd_install() {
  local force=""
  [ "${1:-}" = "--force" ] || [ "${1:-}" = "-f" ] && force=1
  if ! update_if_needed "$force"; then
    ok "Roblox is up to date ($(installed_display_version))"
    apply_customizations
  fi
}

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------

cmd_launch() {
  local url="${1:-}"
  is_macos || die "launching Roblox requires macOS"

  if roblox_running && [ -z "$url" ]; then
    info "Roblox is already running; bringing it to the front"
    info "Quit Roblox (Cmd+Q) and launch again to pick up updates or flag changes"
    open -a "$(app_path)"; return
  fi

  if ! roblox_running; then
    # Never block a launch on a network hiccup if Roblox is already installed.
    if [ -d "$(app_path)" ]; then
      ( update_if_needed ) || true
    else
      update_if_needed || true
    fi
    apply_customizations
  fi
  [ -d "$(app_path)" ] || die "Roblox is not installed"

  if [ -n "$url" ]; then
    case "$url" in
      roblox-player:*|roblox:*) ;;
      *) die "not a Roblox link: $url" ;;
    esac
    info "Joining game"
    log "launch url"
    # `open -a` hands the link to Roblox.app specifically; a bare `open <url>`
    # would bounce it back to us when we are the registered handler.
    open -a "$(app_path)" "$url"
  else
    info "Starting Roblox"
    open -a "$(app_path)"
  fi
}

# ---------------------------------------------------------------------------
# roblox:// link handler
#
# A tiny AppleScript applet that forwards links to this script, registered as
# the default handler for roblox:// and roblox-player:// so website launches
# go through the bootstrapper (and get updates + FastFlags).
# ---------------------------------------------------------------------------

self_path() {
  local src="${BASH_SOURCE[0]}" dir
  dir="$(cd "$(dirname "$src")" && pwd -P)"
  printf '%s/%s' "$dir" "$(basename "$src")"
}

set_url_handler() {
  local bundle_id="$1"
  osascript -l JavaScript - "$bundle_id" >/dev/null <<'EOF'
ObjC.import('CoreServices');
function run(argv) {
  ['roblox-player', 'roblox'].forEach(function (scheme) {
    var rc = $.LSSetDefaultHandlerForURLScheme($(scheme), $(argv[0]));
    if (rc !== 0) throw new Error('LSSetDefaultHandlerForURLScheme(' + scheme + ') failed: ' + rc);
  });
}
EOF
}

# Moves a launcher app installed under its old name to the new one, or drops
# it when the new one is already there, so only one copy is left.
migrate_legacy_app() {
  [ -d "$LEGACY_HANDLER_APP" ] || return 0
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$LEGACY_HANDLER_APP" 2>/dev/null || true
  if [ -d "$HANDLER_APP" ]; then
    rm -rf "$LEGACY_HANDLER_APP"
  else
    mv "$LEGACY_HANDLER_APP" "$HANDLER_APP"
  fi
}

# The SwiftUI launcher (built from app/ or downloaded from GitHub releases)
# as opposed to the AppleScript applet fallback.
handler_is_launcher() { [ -x "$HANDLER_APP/Contents/MacOS/RobloxBootstrapper" ]; }

# Re-sign the handler app and make it the default handler for Roblox links.
# The AppleScript applet has no icon of its own, so it borrows Roblox's; the
# launcher app keeps its own.
finish_handler_app() {
  local plist="$HANDLER_APP/Contents/Info.plist" icon_name icon
  icon_name="$(defaults read "$plist" CFBundleIconFile 2>/dev/null || echo applet)"
  icon_name="${icon_name%.icns}"
  icon="$(app_path)/Contents/Resources/$(defaults read "$(app_path)/Contents/Info.plist" CFBundleIconFile 2>/dev/null || echo AppIcon)"
  case "$icon" in *.icns) ;; *) icon="$icon.icns" ;; esac
  if ! handler_is_launcher && [ -f "$icon" ]; then
    cp "$icon" "$HANDLER_APP/Contents/Resources/$icon_name.icns"
    rm -f "$HANDLER_APP/Contents/Resources/Assets.car"
    /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$plist" 2>/dev/null || true
  fi
  # Editing the bundle invalidates its signature; re-sign ad hoc.
  codesign --force --deep --sign - "$HANDLER_APP" >/dev/null 2>&1 || true
  xattr -dr com.apple.quarantine "$HANDLER_APP" 2>/dev/null || true
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$HANDLER_APP"
  set_url_handler "$HANDLER_BUNDLE_ID" || die "could not set the default handler for roblox:// links"
}

cmd_install_app() {
  is_macos || die "the launcher app requires macOS"
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/roblox-launcher.XXXXXX")"
  info "Downloading the launcher app"
  curl -fsSL --retry 3 --connect-timeout 15 -o "$tmp/app.zip" "$LAUNCHER_ZIP_URL" \
    || { rm -rf "$tmp"; die "could not download $LAUNCHER_ZIP_URL"; }
  ditto -x -k "$tmp/app.zip" "$tmp/x" || { rm -rf "$tmp"; die "launcher archive is corrupt"; }
  [ -d "$tmp/x/Apple Labs.app" ] || { rm -rf "$tmp"; die "launcher archive has no app"; }
  mkdir -p "$(dirname "$HANDLER_APP")"
  rm -rf "$HANDLER_APP"
  mv "$tmp/x/Apple Labs.app" "$HANDLER_APP"
  migrate_legacy_app
  rm -rf "$tmp"
  finish_handler_app
  ok "installed the launcher at $HANDLER_APP"
}

build_applet() {
  local self; self="$(self_path)"
  local script="$SUPPORT_DIR/handler.applescript"
  mkdir -p "$SUPPORT_DIR" "$(dirname "$HANDLER_APP")"

  cat > "$script" <<EOF
on open location theURL
	do shell script quoted form of "$self" & " launch " & quoted form of theURL & " >/dev/null 2>&1 &"
end open location

on run
	do shell script quoted form of "$self" & " launch >/dev/null 2>&1 &"
end run
EOF
  rm -rf "$HANDLER_APP"
  local out
  out="$(osacompile -o "$HANDLER_APP" "$script" 2>&1)" || die "osacompile failed: $out"

  local plist="$HANDLER_APP/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $HANDLER_BUNDLE_ID" "$plist" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $HANDLER_BUNDLE_ID" "$plist"
  /usr/libexec/PlistBuddy -c "Add :LSUIElement bool true" "$plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes array" \
    -c "Add :CFBundleURLTypes:0 dict" \
    -c "Add :CFBundleURLTypes:0:CFBundleURLName string Roblox" \
    -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes array" \
    -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string roblox-player" \
    -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes:1 string roblox" \
    "$plist"
  finish_handler_app
  warn "keep this script at $self — the link handler calls it by path"
}

# register [--applet]: install the launcher app (downloading it if needed) and
# route Roblox links through it; falls back to a minimal AppleScript applet.
cmd_register() {
  is_macos || die "registering a link handler requires macOS"
  migrate_legacy_app
  if handler_is_launcher; then
    finish_handler_app
  elif [ "${1:-}" != "--applet" ] && ( cmd_install_app ) 2>/dev/null; then
    :
  else
    [ "${1:-}" = "--applet" ] || warn "launcher app unavailable; using a minimal link handler instead"
    build_applet
  fi
  ok "roblox:// links now open through the bootstrapper ($HANDLER_APP)"
  info "Open \"$(basename "$HANDLER_APP" .app)\" from Spotlight, Launchpad or the Dock to launch Roblox"
}

cmd_unregister() {
  is_macos || die "requires macOS"
  migrate_legacy_app
  set_url_handler "com.roblox.RobloxPlayer" || warn "could not hand roblox:// links back to Roblox"
  # Only delete the applet; the launcher app stays usable without links.
  if [ -f "$HANDLER_APP/Contents/MacOS/applet" ] || [ "${1:-}" = "--remove-app" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$HANDLER_APP" 2>/dev/null || true
    rm -rf "$HANDLER_APP"
  fi
  ok "roblox:// links open Roblox directly again"
}

# ---------------------------------------------------------------------------
# Accounts
#
# The Roblox app keeps its sign-in in a cookie jar. A saved account is a copy
# of that jar plus the account's name, kept only on this Mac with owner-only
# permissions. Switching swaps the jar while Roblox is closed. Nothing is sent
# anywhere and passwords are never involved.
# ---------------------------------------------------------------------------

ROBLOX_COOKIES="${ROBLOX_COOKIES_FILE:-$HOME/Library/HTTPStorages/com.roblox.RobloxPlayer.binarycookies}"
ROBLOX_APP_STORAGE="${ROBLOX_APP_STORAGE_FILE:-$HOME/Library/Roblox/LocalStorage/appStorage.json}"
ACCOUNTS_DIR="$SUPPORT_DIR/Accounts"

accounts_init() {
  (umask 077; mkdir -p "$ACCOUNTS_DIR")
  chmod 700 "$ACCOUNTS_DIR"
}

# A value from Roblox's own app storage (UserId, Username, DisplayName).
storage_value() {
  [ -f "$ROBLOX_APP_STORAGE" ] || return 0
  plutil -extract "$1" raw -o - "$ROBLOX_APP_STORAGE" 2>/dev/null || true
}

account_value() {
  plutil -extract "$2" raw -o - "$ACCOUNTS_DIR/$1/account.json" 2>/dev/null || true
}

# Identifies the current version of Roblox's app storage file. Roblox rewrites
# it whenever it runs, so a change means Roblox has run since we looked.
storage_fingerprint() {
  if [ -f "$ROBLOX_APP_STORAGE" ]; then stat -f '%i:%m:%z' "$ROBLOX_APP_STORAGE"; else echo none; fi
}

# Serialises account changes so a switch and an automatic save can't interleave.
accounts_lock() {
  local tries=0
  # A lock left behind by a killed process is cleared after a minute.
  [ -n "$(find "$ACCOUNTS_DIR/.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$ACCOUNTS_DIR/.lock" 2>/dev/null
  until mkdir "$ACCOUNTS_DIR/.lock" 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -gt 150 ] && die "another account change is still running; try again"
    sleep 0.1
  done
  trap 'rmdir "$ACCOUNTS_DIR/.lock" 2>/dev/null' EXIT
}

# Records that we changed the session, and what Roblox's own record looked
# like at that moment.
mark_switched() {
  storage_fingerprint > "$ACCOUNTS_DIR/.switched"
}

# The cookie jar holds a session only while someone is signed in.
roblox_signed_in() {
  [ -f "$ROBLOX_COOKIES" ] && LC_ALL=C grep -aq 'ROBLOSECURITY' "$ROBLOX_COOKIES"
}

# Prints "<user id>\t<username>\t<display name>" for the account whose session
# is in Roblox's cookie jar; nothing when signed out or unknown.
current_account() {
  roblox_signed_in || return 0
  local id
  if [ -f "$ACCOUNTS_DIR/.switched" ] && [ "$(cat "$ACCOUNTS_DIR/.switched")" = "$(storage_fingerprint)" ]; then
    # We swapped sessions and Roblox hasn't run since, so its own record is stale.
    id="$(cat "$ACCOUNTS_DIR/.active" 2>/dev/null || true)"
    [ -n "$id" ] && [ -f "$ACCOUNTS_DIR/$id/account.json" ] || return 0
    printf '%s\t%s\t%s\n' "$id" "$(account_value "$id" username)" "$(account_value "$id" displayName)"
    return 0
  fi
  id="$(storage_value UserId)"
  case "$id" in ''|*[!0-9]*) return 0 ;; esac
  printf '%s\t%s\t%s\n' "$id" "$(storage_value Username)" "$(storage_value DisplayName)"
}

# Finds a saved account by user id, username or display name.
find_account() {
  local who dir id field
  who="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$1" in
    *[!0-9]*|'') ;;
    *) [ -f "$ACCOUNTS_DIR/$1/account.json" ] && { printf '%s\n' "$1"; return 0; } ;;
  esac
  for dir in "$ACCOUNTS_DIR"/*/; do
    [ -f "$dir/account.json" ] || continue
    id="$(basename "$dir")"
    for field in username displayName; do
      if [ "$(account_value "$id" "$field" | tr '[:upper:]' '[:lower:]')" = "$who" ]; then
        printf '%s\n' "$id"
        return 0
      fi
    done
  done
  return 1
}

accounts_rows() {
  local dir id
  for dir in "$ACCOUNTS_DIR"/*/; do
    [ -f "$dir/account.json" ] || continue
    id="$(basename "$dir")"
    printf '%s\t%s\t%s\t%s\n' "$id" "$(account_value "$id" username)" \
      "$(account_value "$id" displayName)" "$(account_value "$id" savedAt)"
  done
}

# save [--quiet] [--auto]: remember the signed-in account. --auto (used after
# Roblox quits) only refreshes accounts that are already saved, plus one that
# is being added, so removing an account here sticks.
accounts_save() {
  local quiet="" auto="" arg info id username display dir
  for arg in "$@"; do
    case "$arg" in --quiet) quiet=1 ;; --auto) auto=1; quiet=1 ;; esac
  done
  accounts_init
  info="$(current_account)"
  if [ -z "$info" ]; then
    [ -n "$quiet" ] && return 0
    die "no Roblox account is signed in on this Mac (open Roblox and sign in first)"
  fi
  IFS=$'\t' read -r id username display <<< "$info"
  dir="$ACCOUNTS_DIR/$id"
  if [ -n "$auto" ] && [ ! -f "$dir/account.json" ] && [ ! -f "$ACCOUNTS_DIR/.adding" ]; then
    return 0
  fi
  (umask 077; mkdir -p "$dir" && cp "$ROBLOX_COOKIES" "$dir/cookies.tmp") \
    && mv "$dir/cookies.tmp" "$dir/cookies.binarycookies" \
    || die "could not save the session for $username"
  json_js 'return JSON.stringify({userId: args[0], username: args[1], displayName: args[2], savedAt: args[3]}, null, 2);' \
    "$id" "$username" "$display" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/account.json.tmp"
  chmod 600 "$dir/account.json.tmp"
  mv "$dir/account.json.tmp" "$dir/account.json"
  printf '%s\n' "$id" > "$ACCOUNTS_DIR/.active"
  rm -f "$ACCOUNTS_DIR/.adding"
  [ -n "$quiet" ] || ok "saved ${display:-$username} (@$username)"
}

accounts_use() {
  [ $# -ge 1 ] || die "usage: accounts use <user id | username>"
  accounts_init
  local id
  id="$(find_account "$1")" || die "no saved account matches '$1' (see \`$(basename "$0") accounts list\`)"
  roblox_running && die "quit Roblox before switching accounts"
  # Keep the current session before replacing it.
  accounts_save --quiet
  mkdir -p "$(dirname "$ROBLOX_COOKIES")"
  (umask 077; cp "$ACCOUNTS_DIR/$id/cookies.binarycookies" "$ROBLOX_COOKIES.tmp") \
    && mv "$ROBLOX_COOKIES.tmp" "$ROBLOX_COOKIES" \
    || die "could not switch accounts"
  printf '%s\n' "$id" > "$ACCOUNTS_DIR/.active"
  mark_switched
  rm -f "$ACCOUNTS_DIR/.adding"
  ok "switched to $(account_value "$id" displayName) (@$(account_value "$id" username))"
}

# Signs the Roblox app out on this Mac (the session itself stays valid and is
# saved first) so another account can sign in.
accounts_add() {
  accounts_init
  roblox_running && die "quit Roblox before adding an account"
  accounts_save --quiet
  if roblox_signed_in && [ ! -f "$ACCOUNTS_DIR/$(current_account | cut -f1)/account.json" ]; then
    # Never throw away a session we couldn't identify.
    (umask 077; cp "$ROBLOX_COOKIES" "$ACCOUNTS_DIR/unsaved-$(date +%Y%m%d%H%M%S).binarycookies")
  fi
  rm -f "$ROBLOX_COOKIES"
  : > "$ACCOUNTS_DIR/.active"
  mark_switched
  touch "$ACCOUNTS_DIR/.adding"
  ok "Roblox is signed out on this Mac"
  info "Open Roblox and sign in with the other account; the launcher app saves it when Roblox quits"
  info "(or run \`$(basename "$0") accounts save\` once you've signed in)"
}

accounts_remove() {
  [ $# -ge 1 ] || die "usage: accounts remove <user id | username>"
  accounts_init
  local id name
  id="$(find_account "$1")" || die "no saved account matches '$1'"
  name="$(account_value "$id" displayName)"
  rm -rf "${ACCOUNTS_DIR:?}/$id"
  [ "$(cat "$ACCOUNTS_DIR/.active" 2>/dev/null || true)" = "$id" ] && : > "$ACCOUNTS_DIR/.active"
  ok "removed ${name:-$id} from the launcher (this doesn't sign it out anywhere)"
}

accounts_list() {
  accounts_init
  local current rows arg as_json=""
  for arg in "$@"; do [ "$arg" = "--json" ] && as_json=1; done
  current="$(current_account)"
  rows="$(accounts_rows)"
  if [ -n "$as_json" ]; then
    json_js '
      var cur = args[0] ? args[0].split("\t") : null;
      var accounts = (args[1] ? args[1].split("\n") : []).filter(function (r) { return r; }).map(function (r) {
        var f = r.split("\t");
        return { userId: f[0], username: f[1], displayName: f[2], savedAt: f[3] || null,
                 active: !!cur && cur[0] === f[0] };
      });
      return JSON.stringify({
        current: cur ? { userId: cur[0], username: cur[1], displayName: cur[2] } : null,
        signedIn: args[2] === "yes",
        accounts: accounts
      }, null, 2);
    ' "$current" "$rows" "$(roblox_signed_in && echo yes || echo no)"
    return
  fi
  if [ -z "$rows" ]; then
    printf 'No saved accounts yet. Run `%s accounts save` to save the one signed in now.\n' "$(basename "$0")"
  else
    printf '%sSaved accounts%s\n' "$C_BOLD" "$C_OFF"
    printf '%s\n' "$rows" | while IFS=$'\t' read -r id username display saved; do
      if [ "$id" = "$(printf '%s' "$current" | cut -f1)" ]; then mark="●"; else mark=" "; fi
      printf '  %s %s (@%s)  %s%s%s\n' "$mark" "$display" "$username" "$C_DIM" "$id" "$C_OFF"
    done
  fi
  if [ -n "$current" ]; then
    printf '\nSigned in to Roblox: %s (@%s)\n' "$(printf '%s' "$current" | cut -f3)" "$(printf '%s' "$current" | cut -f2)"
  else
    printf '\nRoblox is signed out on this Mac.\n'
  fi
}

cmd_accounts() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  accounts_init
  case "$sub" in list|ls) ;; *) accounts_lock ;; esac
  case "$sub" in
    list|ls) accounts_list "$@" ;;
    save) accounts_save "$@" ;;
    use|switch) accounts_use "$@" ;;
    add) accounts_add "$@" ;;
    remove|rm) accounts_remove "$@" ;;
    *) die "unknown accounts command '$sub' (list, save, use, add, remove)" ;;
  esac
}

# ---------------------------------------------------------------------------
# Config / status / uninstall
# ---------------------------------------------------------------------------

cmd_config() {
  local sub="${1:-show}"; [ $# -gt 0 ] && shift
  case "$sub" in
    show)
      printf 'CHANNEL=%s\nINSTALL_DIR=%s\nARCH=%s\n' "$CHANNEL" "$INSTALL_DIR" "$ARCH" ;;
    set)
      [ $# -eq 2 ] || die "usage: config set <CHANNEL|INSTALL_DIR|ARCH> <value>"
      local key="$1" val="$2"
      case "$key" in
        CHANNEL|channel) key=CHANNEL ;;
        INSTALL_DIR|install_dir) key=INSTALL_DIR; val="${val/#\~/$HOME}" ;;
        ARCH|arch) key=ARCH
          case "$val" in auto|arm64|x86_64) ;; *) die "ARCH must be auto, arm64 or x86_64" ;; esac ;;
        *) die "unknown setting '$key' (CHANNEL, INSTALL_DIR, ARCH)" ;;
      esac
      mkdir -p "$SUPPORT_DIR"; touch "$CONFIG_FILE"
      grep -v "^$key=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" || true
      printf '%s=%q\n' "$key" "$val" >> "$CONFIG_FILE.tmp"
      mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
      ok "$key=$val (run \`$0 install --force\` to switch builds)" ;;
    reset) rm -f "$CONFIG_FILE"; ok "settings reset to defaults" ;;
    *) die "unknown config command '$sub' (show, set, reset)" ;;
  esac
}

status_json() {
  local latest="" cur running=false handler=false
  cur="$(installed_version)"
  latest="$(fetch_latest 2>/dev/null)" || latest=""
  roblox_running && running=true
  { [ -d "$HANDLER_APP" ] || [ -d "$LEGACY_HANDLER_APP" ]; } && handler=true
  ensure_fflags_file
  mkdir -p "$MODS_DIR"
  json_js '
    var latest = args[5] ? args[5].split(" ") : null;
    var installed = args[3] || null, hash = args[4] || null;
    return JSON.stringify({
      version: args[0], installPath: args[1], installDir: args[13], channel: args[2],
      arch: args[6], archSetting: args[12],
      installed: installed, installedHash: hash,
      latest: latest ? latest[1] : null, latestHash: latest ? latest[0] : null,
      upToDate: latest ? (hash === latest[0] || (!hash && installed === latest[1])) : null,
      running: args[7] === "true", handlerInstalled: args[8] === "true",
      fflagsPath: args[9], modsPath: args[10], supportPath: args[11], logPath: args[14]
    }, null, 2);
  ' "$VERSION" "$(app_path)" "$CHANNEL" "$(installed_display_version)" "$cur" "$latest" \
    "$(resolve_arch)" "$running" "$handler" "$FFLAGS_FILE" "$MODS_DIR" "$SUPPORT_DIR" "$ARCH" "$INSTALL_DIR" "$LOG_FILE"
}

cmd_status() {
  [ "${1:-}" = "--json" ] && { status_json; return; }
  local latest cur
  printf '%sRoblox Bootstrapper%s %s\n\n' "$C_BOLD" "$C_OFF" "$VERSION"
  printf '  Install path   %s\n' "$(app_path)"
  printf '  Channel        %s\n' "$CHANNEL"
  printf '  Architecture   %s\n' "$(resolve_arch)"
  cur="$(installed_version)"
  if [ -n "$cur" ]; then printf '  Installed      %s %s(%s)%s\n' "$(installed_display_version)" "$C_DIM" "$cur" "$C_OFF"
  elif [ -d "$(app_path)" ]; then printf '  Installed      %s (not managed by the bootstrapper)\n' "$(installed_display_version)"
  else printf '  Installed      no\n'; fi
  if latest="$(fetch_latest 2>/dev/null)"; then
    printf '  Latest         %s %s(%s)%s\n' "${latest#* }" "$C_DIM" "${latest%% *}" "$C_OFF"
    if [ "$cur" = "${latest%% *}" ] || { [ -z "$cur" ] && [ "$(installed_display_version)" = "${latest#* }" ]; }; then printf '  Status         %sup to date%s\n' "$C_GRN" "$C_OFF"
    else printf '  Status         %supdate available%s\n' "$C_YEL" "$C_OFF"; fi
  else
    printf '  Latest         (offline)\n'
  fi
  ensure_fflags_file
  printf '  FastFlags      %s set\n' "$(json_js 'return Object.keys(JSON.parse(args[0])).length;' "$(cat "$FFLAGS_FILE")")"
  mkdir -p "$MODS_DIR"
  printf '  Mods           %s files\n' "$(find "$MODS_DIR" -type f ! -name .DS_Store | wc -l | tr -d ' ')"
  if [ -d "$HANDLER_APP" ] || [ -d "$LEGACY_HANDLER_APP" ]; then printf '  Link handler   registered\n'
  else printf '  Link handler   not registered\n'; fi
}

cmd_uninstall() {
  local purge=""
  [ "${1:-}" = "--purge" ] && purge=1
  roblox_running && die "quit Roblox first"
  if [ -d "$HANDLER_APP" ] || [ -d "$LEGACY_HANDLER_APP" ]; then cmd_unregister --remove-app; fi
  if [ -d "$(app_path)" ]; then rm -rf "$(app_path)"; ok "removed $(app_path)"; fi
  rm -f "$STATE_FILE"
  if [ -n "$purge" ]; then
    rm -rf "$SUPPORT_DIR"
    ok "removed bootstrapper settings and FastFlags"
  else
    info "kept your FastFlags and settings in $SUPPORT_DIR (use --purge to remove)"
  fi
}

usage() {
  cat <<EOF
${C_BOLD}roblox-bootstrapper${C_OFF} $VERSION — install, update and launch Roblox on macOS

${C_BOLD}Usage:${C_OFF} $(basename "$0") <command> [args]

  install [--force]         Install Roblox, or update it if a new version is out
  update                    Same as install
  launch [roblox-link]      Update if needed, apply FastFlags, and start Roblox
  status [--json]           Show installed/latest versions and settings

  fflags list               Show your FastFlags
  fflags set <Flag> <val>   Set a flag (true/false/integers are typed automatically)
  fflags unset <Flag>...    Remove flags
  fflags import <file>      Merge flags from a JSON file
  fflags edit | clear       Edit in \$EDITOR / remove all flags
  fflags apply              Re-write flags into the installed client

  mods list | apply | clear Files in the mods folder replace Roblox's own files
  mods path                 (the folder mirrors Roblox.app/Contents/Resources)

  accounts [list]           Saved Roblox accounts (● = signed in now)
  accounts save             Save the account signed in to Roblox now
  accounts use <name|id>    Switch Roblox to a saved account (Roblox must be closed)
  accounts add              Sign Roblox out here so you can sign in to another account
  accounts remove <name|id> Forget a saved account (doesn't sign it out anywhere)

  register [--applet]       Install the launcher app and send roblox:// links
                            through it (--applet: minimal handler, no GUI)
  install-app               Download or update the launcher app
  unregister                Hand roblox:// links back to Roblox
  config [show]             Show settings
  config set <KEY> <value>  CHANNEL (default LIVE), INSTALL_DIR (default
                            /Applications), ARCH (auto, arm64, x86_64)
  uninstall [--purge]       Remove Roblox (and with --purge, your settings)

Settings and flags live in: $SUPPORT_DIR
EOF
}

main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    install|update) cmd_install "$@" ;;
    launch|play) cmd_launch "$@" ;;
    roblox-player:*|roblox:*) cmd_launch "$cmd" ;;
    status) cmd_status "$@" ;;
    fflags|flags) cmd_fflags "$@" ;;
    mods|mod) cmd_mods "$@" ;;
    accounts|account) cmd_accounts "$@" ;;
    register) cmd_register "$@" ;;
    install-app) cmd_install_app ;;
    unregister) cmd_unregister ;;
    config) cmd_config "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    version|--version|-v) printf '%s\n' "$VERSION" ;;
    help|--help|-h|"") usage ;;
    *) usage >&2; die "unknown command '$cmd'" ;;
  esac
}

main "$@"
